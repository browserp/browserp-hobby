{
  "name": "browserp-platform",
  "version": "2.4.2",
  "private": true,
  "description": "BrowseRP cross-game roleplay server directory and owner listing platform.",
  "type": "module",
  "scripts": {
    "dev": "node dev-server.mjs",
    "start": "node dev-server.mjs",
    "check": "node test/check.mjs",
    "test": "node --test test/*.test.mjs",
    "test:db": "node --test test/*-db.mjs",
    "verify": "npm run check && npm test && npm run test:db"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "jsdom": "30.0.1"
  },
  "dependencies": {
    "@vercel/functions": "3.9.5"
  }
}
