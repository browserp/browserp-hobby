    [
      {
        "relname": "developer_directory",
        "owner": "postgres",
        "reloptions": [
          "security_invoker=false",
          "security_barrier=true"
        ],
        "anon_read": true,
        "member_read": true,
        "anon_write": false,
        "member_write": false,
        "definition": " SELECT dp.user_id AS id,\n    p.display_name,\n    p.username,\n        CASE\n            WHEN p.avatar_review_status = 'approved'::text THEN p.approved_avatar_url\n            ELSE NULL::text\n        END AS avatar_url,\n    dp.headline,\n    dp.specialties,\n    dp.portfolio_url,\n    dp.verified,\n    dp.created_at\n   FROM developer_profiles dp\n     JOIN profiles p ON p.id = dp.user_id\n  WHERE dp.status = 'published'::text AND p.profile_visibility = 'public'::text;"
      },
      {
        "relname": "resource_directory",
        "owner": "postgres",
        "reloptions": [
          "security_invoker=false",
          "security_barrier=true"
        ],
        "anon_read": true,
        "member_read": true,
        "anon_write": false,
        "member_write": false,
        "definition": " SELECT r.id,\n    r.title,\n    r.slug,\n    r.summary,\n    r.resource_type,\n    r.download_count AS downloads,\n    r.published_at,\n    p.name AS platform_name,\n    pr.display_name AS author_name\n   FROM resources r\n     JOIN profiles pr ON pr.id = r.author_id AND pr.profile_visibility = 'public'::text\n     LEFT JOIN platforms p ON p.id = r.platform_id AND p.enabled\n  WHERE r.status = 'published'::text;"
      }
