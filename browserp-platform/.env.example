APP_URL=https://www.browserp.com
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only; use a modern sb_secret_ key or legacy service_role key.
SUPABASE_SECRET_KEY=
PRIVACY_HASH_SECRET=

# Set true on the bridge and integrated release during the controlled rollout.
# This deployment-local pause does not disable older immutable deployments.
CONTENT_WRITES_PAUSED=false

# Keep false until the complete payment launch checklist passes.
# This gates new Checkout sessions. Already-issued paid sessions still settle.
PAYMENTS_ENABLED=false
# Emergency-only settlement switch; disabling it requires manual reconciliation.
STRIPE_FULFILLMENT_ENABLED=true
# Required by Vercel so Stripe signatures use the untouched request bytes.
NODEJS_HELPERS=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_LAUNCH=
SUPABASE_FULFILLMENT_SECRET=

# Disabled until reviewed private mappings, bot hierarchy and paused cron are approved.
DISCORD_ROLE_SYNC_ENABLED=false
# Server-only dedicated bot credential. Never use a user/account token.
DISCORD_ROLE_SYNC_BOT_TOKEN=
